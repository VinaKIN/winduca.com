{
  "editor.formatOnSave": false,
  "files.eol": "\n",
  "typescript.tsdk": "node_modules/typescript/lib",
  "tailwindCSS.experimental.classRegex": [
    [
      "className=\\{`([^`]*)`\\}",
      "[\"'`]([^\"'`]*).*?[\"'`]"
    ]
  ],
  "files.exclude": {
    "**/.next": true,
    "**/out": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/.next": true,
    "**/out": true,
    "**/public/images": true
  }
}