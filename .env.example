# Sao chép thành .env.local (KHÔNG commit). Giá trị thật do WINDUCA cấp.

# Kho nhận lead (kho mã hóa/CRM nội bộ). Website KHÔNG lưu dữ liệu khách.
# Nếu thiếu, /api/lead trả 503 để không nuốt dữ liệu âm thầm.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=

# Thông báo nội bộ qua Telegram: chỉ gửi MÃ và LOẠI, không có SĐT.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Chống spam (chưa nối vào mã; dự kiến Cloudflare Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# GA4 (tuỳ chọn): chỉ nạp khi khách đồng ý cookie. Đặt thành vars.GA_ID trong workflow Pages hoặc biến môi trường Vercel.
NEXT_PUBLIC_GA_ID=
